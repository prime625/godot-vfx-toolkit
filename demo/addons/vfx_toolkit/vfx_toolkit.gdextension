[configuration]
entry_symbol = "vfx_toolkit_library_init"
compatibility_minimum = 4.3
reloadable = true

[libraries]
macos.debug = "res://addons/vfx_toolkit/libvfx_toolkit.macos.template_debug.framework"
macos.release = "res://addons/vfx_toolkit/libvfx_toolkit.macos.template_release.framework"
windows.debug.x86_64 = "res://addons/vfx_toolkit/libvfx_toolkit.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/vfx_toolkit/libvfx_toolkit.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/vfx_toolkit/libvfx_toolkit.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/vfx_toolkit/libvfx_toolkit.linux.template_release.x86_64.so"
android.debug.arm64 = "res://addons/vfx_toolkit/libvfx_toolkit.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/vfx_toolkit/libvfx_toolkit.android.template_release.arm64.so"
android.debug.arm32 = "res://addons/vfx_toolkit/libvfx_toolkit.android.template_debug.arm32.so"
android.release.arm32 = "res://addons/vfx_toolkit/libvfx_toolkit.android.template_release.arm32.so"
